# =============================================================================
# Piston limits: the ONE source of truth for production and for the escape tests.
#
# Read by:
#   deploy/piston/run-piston.sh           hands it to the production container "piston-api"
#   deploy/escape-tests/run-in-docker.sh  checks that the running container has every line
#   deploy/escape-tests/run.mjs           derives its time and size thresholds from it
# so the tests judge the container against the numbers it was started with.
# Change a limit HERE, then run run-piston.sh again to apply it.
#
# FORMAT RULES (docker --env-file is not a shell):
#   - KEY=VALUE, one per line, no "export", no quotes (they would be stored
#     as part of the value).
#   - Comments only on their own lines, starting with "#". A trailing "# ..."
#     after a value would become part of the value.
#   - LF line endings only (run-piston.sh refuses a file with CR characters).
#   - Piston reads all of these from PISTON_-prefixed variables. Sizes are in
#     bytes, times in milliseconds.
#
# THE BOX THIS IS SIZED FOR: Ubuntu 24.04, 1 GB RAM + 1 GB swap, 2 burstable
# vCPUs. It also runs Nginx and the NestJS backend (pm2, capped near 350 MB), so
# the Piston container is allowed 640 MB at most (see run-piston.sh). Rough
# budget: OS ~150 MB + Nginx ~20 MB + backend up to ~350 MB + Piston up to
# 640 MB is more than 1 GB, so the swap file absorbs spikes, and the limits
# below exist to make sure that when something has to give, it is one runaway
# job and not the whole machine.
#
# Request-level limits sent in the /execute body (the backend sends its own, see
# backend/src/judge/judge.service.ts) can only LOWER these. Piston answers a
# higher value with HTTP 400 "... cannot exceed the configured limit of ...".
# =============================================================================

# Jobs get no network at all. Piston runs each job in its own empty network
# namespace (its isolate sandbox, started without --share-net): no interface, no
# route. User code cannot reach the internet, the EC2 metadata service at
# 169.254.169.254 (which hands out the instance's IAM credentials), services on
# the Docker bridge such as the host's sshd, or Piston's own API on loopback.
# This is Piston's default; it is pinned here so an upstream change of default
# can never silently turn networking on.
PISTON_DISABLE_NETWORKING=true

# Wall-clock limit for running one program. Matches the backend's
# JUDGE_RUN_TIMEOUT_MS default. A sleeping program is stopped by this one.
PISTON_RUN_TIMEOUT=3000

# Wall-clock limit for compiling (g++). A cold g++ on a burstable vCPU can take
# several seconds, so this is more generous than the run limit.
PISTON_COMPILE_TIMEOUT=10000

# CPU-time limits. Wall time alone is not enough on 2 burstable vCPUs: a busy
# loop would burn CPU credits for the full wall limit while other jobs starve.
# CPU time stops a spinning program as soon as it has actually used its share.
PISTON_RUN_CPU_TIME=3000
PISTON_COMPILE_CPU_TIME=10000

# Memory per job: 128 MiB to run, 384 MiB to compile. Piston's own default is
# -1, meaning UNLIMITED, which is how one "allocate 2 GB" submission would push
# the box into swap and take the backend down with it. With at most 2 jobs at a
# time (PISTON_MAX_CONCURRENT_JOBS) the worst case is 2 x 384 MiB, and a normal
# single-file g++ run stays far below that. The container's own 640 MB cap is
# the backstop if these are ever exceeded.
PISTON_RUN_MEMORY_LIMIT=134217728
PISTON_COMPILE_MEMORY_LIMIT=402653184

# Bytes of stdout and of stderr Piston keeps per job (default 1024, too small
# for real test output). A job that goes past this is killed with status OL
# (EL for stderr). 64 KiB is plenty for a judge and keeps every HTTP response
# small; the backend refuses responses over 1 MB anyway.
PISTON_OUTPUT_MAX_SIZE=65536

# Fork-bomb cap: the most processes one job (one uid) may have at once. Piston
# gives each job its own uid, so jobs do not eat each other's allowance. The
# container's --pids-limit=256 (run-piston.sh) is the second line of defence:
# 2 jobs x 64 plus Piston's own processes stays well under it.
PISTON_MAX_PROCESS_COUNT=64

# Open file descriptors per job (default 2048). Ordinary programs need a few
# dozen; a low cap makes descriptor-exhaustion attacks cheap to survive.
PISTON_MAX_OPEN_FILES=256

# Largest single file a job may write, in bytes (default 10 MB). Bounds disk
# use on a small volume and also caps the size of a compiled binary.
PISTON_MAX_FILE_SIZE=5242880

# Jobs running at once (default 64, far too many for this box: 64 g++ processes
# would exhaust 1 GB in seconds). 2 matches the 2 vCPUs and the backend's own
# queue (PISTON_MAX_CONCURRENCY=2 in execution-limiter.ts); extra requests
# wait in line instead of running in parallel.
PISTON_MAX_CONCURRENT_JOBS=2

# Piston's log verbosity. INFO is enough for operations. DEBUG logs every job
# in detail, which costs CPU and disk here; Docker's log rotation in
# run-piston.sh (3 files x 10 MB) is only the backstop. (run-in-docker.sh counts
# the INFO line "Executing job" to warn when the site is in use.)
PISTON_LOG_LEVEL=INFO

# Not set on purpose: PISTON_LIMIT_OVERRIDES, Piston's per-language exceptions to
# the limits above. It is written as JSON, which needs quotes, and run-piston.sh
# refuses quotes in this file. The limits above apply to every language.
