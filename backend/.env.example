# CodeCraft backend settings. Copy to .env (local) or /etc/codecraft/backend.env (EC2),
# fill in the blanks, and never commit the filled-in file. The server refuses to
# start if a required setting is missing or weak, and says which one (never its value).

# ---- Runtime -----------------------------------------------------------------
NODE_ENV=production
# Loopback only: Nginx on the same machine is the only thing that talks to the app.
# (The AWS security group cannot be changed, so never set this to 0.0.0.0.)
HOST=127.0.0.1
PORT=3000
# Reverse proxies in front of the app (Nginx = 1). Makes req.ip the real client address.
# Put Cloudflare in front as well and it is still 1 hop as long as Nginx restores the
# client address from CF-Connecting-IP (deploy/nginx/cloudflare-realip.conf does).
TRUST_PROXY_HOPS=1

# ---- Database and cache -------------------------------------------------------
# Supabase -> Connect -> Session pooler (port 5432). NOT the transaction pooler (migrations
# fail on it) and NOT the direct connection (IPv6 only).
DATABASE_URL=
# Redis Cloud -> the plain redis://default:PASSWORD@HOST:PORT url.
REDIS_URL=

# ---- Sign-in ------------------------------------------------------------------
# Required. At least 32 characters, not a placeholder. Generate with:  openssl rand -base64 48
JWT_SECRET=
# How long a student's sign-in lasts. Demo (guest) sessions always last 2 hours.
JWT_EXPIRES_IN=12h
# Google Cloud Console -> Credentials -> OAuth client (rotate the secret if it ever leaked).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must also be listed under "Authorized redirect URIs" for the OAuth client.
GOOGLE_CALLBACK_URL=https://api.example.com/auth/google/callback
# The deployed frontend: where Google sign-in returns to, and the browser origin allowed to call the API.
FRONTEND_URL=https://codecraft.example.com
# More allowed browser origins, comma separated (e.g. a preview domain). Never localhost in production.
CORS_ORIGINS=
# Phase 1 leftover: email + password sign-in. Off unless this is exactly "true". Leave it off.
PASSWORD_LOGIN_ENABLED=false

# ---- Code runner (Piston) ------------------------------------------------------
# Piston listens on loopback only (deploy/piston/run-piston.sh).
PISTON_URL=http://127.0.0.1:2000
# Programs running at the same time. The 1 GB box is sized for 2; demo users can hold at most 1.
PISTON_MAX_CONCURRENCY=2
# How many /run requests may wait for a slot before new ones are turned away with 503.
RUN_MAX_QUEUE=20
# Graded submissions judged at the same time (1 to 4).
SUBMISSION_WORKER_CONCURRENCY=2
# Per-run limits sent with every execution. Piston's own container-level caps apply on top
# (deploy/piston/limits.env); a request can lower a cap, never raise it.
JUDGE_RUN_TIMEOUT_MS=3000
JUDGE_COMPILE_TIMEOUT_MS=10000
JUDGE_RUN_MEMORY_BYTES=134217728
JUDGE_COMPILE_MEMORY_BYTES=402653184
